{
	"name": "niceimage",
	"version": "0.1.0",
	"description": "Generate images from a prompt by having an LLM write Satori code",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/takumi3488/niceimage.git"
	},
	"homepage": "https://github.com/takumi3488/niceimage#readme",
	"bugs": "https://github.com/takumi3488/niceimage/issues",
	"keywords": [
		"cli",
		"image",
		"satori",
		"llm",
		"bun"
	],
	"bin": {
		"nimg": "./src/cli.ts"
	},
	"type": "module",
	"files": [
		"src",
		"!src/**/*.test.ts"
	],
	"engines": {
		"bun": ">=1.2.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"fmt": "biome format .",
		"fmt:fix": "biome format --write .",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"typecheck": "tsgo --noEmit",
		"test": "bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/bun": "latest",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"oxlint": "1.83.0"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^0.85.1",
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@resvg/resvg-wasm": "^2.6.2",
		"satori": "^0.33.4",
		"typebox": "1.3.7"
	}
}
